<!doctype html>
<html lang="pt-BR">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Serviços · BarberCom</title><link rel="stylesheet" href="/style.css"><script src="/app.js" defer></script></head>
<body>
<main class="phone management">
  <header>
    <form action="/sair" method="post" class="logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button aria-label="Sair da conta" title="Sair da conta">↪</button></form>
    <img class="logo" src="/logo.png" alt="BarberCom" width="150" height="141">
    <h1>Gerenciamento de serviços</h1>
    <a class="primary add" href="/servicos/novo">＋ Novo serviço</a>
  </header>
  <% if (aviso) { %><p class="success" role="status"><%= aviso %></p><% } %>
  <section class="cards" aria-label="Serviços cadastrados">
    <% if (!servicos.length) { %><p class="empty">Nenhum serviço cadastrado. Clique em “Novo serviço” para começar.</p><% } %>
    <% for (const servico of servicos) { const ofertasServico = ofertas.filter(o => o.servico_id === servico.id); %>
      <article class="unit-card service-card">
        <h2><%= servico.nome %></h2>
        <div class="service-prices">
          <% for (const oferta of ofertasServico) { %>
            <p><%= oferta.unidade_nome %><%= oferta.unidade_ativa ? '' : ' (inativa)' %> · <strong><%= Number(oferta.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong><span><%= oferta.duracao_minutos %> min</span></p>
          <% } %>
        </div>
        <div class="service-status badge <%= servico.ativo ? 'active' : 'inactive' %>">● <%= servico.ativo ? 'Ativo' : 'Inativo' %></div>
        <div class="card-actions">
          <a class="secondary" href="/servicos/<%= servico.id %>/editar">✎ Editar</a>
          <form method="post" action="/servicos/<%= servico.id %>/situacao" data-toggle-form data-active-label="Ativo" data-inactive-label="Inativo">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="ativo" value="<%= !servico.ativo %>">
            <button class="<%= servico.ativo ? 'danger' : 'reactivate' %>" aria-pressed="<%= servico.ativo %>" aria-label="<%= servico.ativo ? 'Inativar' : 'Reativar' %> <%= servico.nome %>"><span class="toggle-track" aria-hidden="true"><span></span></span><span data-toggle-label><%= servico.ativo ? 'Inativar' : 'Reativar' %></span></button>
          </form>
        </div>
      </article>
    <% } %>
  </section>
  <%- include('partials/nav', { pagina: 'servicos' }) %>
</main>
<% if (form) { %>
  <dialog aria-labelledby="form-title" data-dialog-return="/servicos">
    <div class="dialog-title"><h2 id="form-title"><%= form.id ? 'Editar serviço' : 'Novo serviço' %></h2><a class="close" href="/servicos" aria-label="Fechar formulário">×</a></div>
    <form method="post" action="<%= form.id ? '/servicos/' + form.id : '/servicos' %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="nome">Nome</label><input id="nome" name="nome" required maxlength="120" value="<%= form.nome %>" autofocus>
      <fieldset class="choices"><legend>Unidades, preços e duração</legend>
        <% if (!unidades.length) { %><p class="help">Cadastre uma <a href="/unidades/nova">unidade</a> primeiro.</p><% } %>
        <% for (const unidade of unidades) { const selected = form.unidades.includes(unidade.id); %>
          <div class="offer-option">
            <label class="choice"><input type="checkbox" name="unidades" value="<%= unidade.id %>" data-offer-option <%= selected ? 'checked' : '' %> <%= !unidade.ativa && !selected ? 'disabled' : '' %>><span><%= unidade.nome %><%= unidade.ativa ? '' : ' (inativa)' %></span></label>
            <div class="offer-values">
              <label>Preço (R$)<input type="text" inputmode="decimal" name="preco_<%= unidade.id %>" value="<%= form.precos[unidade.id] ?? '' %>" placeholder="35,00" maxlength="11" aria-label="Preço em <%= unidade.nome %>"></label>
              <label>Duração (min)<input type="number" name="duracao_<%= unidade.id %>" value="<%= form.duracoes[unidade.id] ?? '' %>" min="1" max="1440" aria-label="Duração em <%= unidade.nome %>"></label>
            </div>
          </div>
        <% } %>
      </fieldset>
      <%- include('partials/situacao', { ativo: form.ativo }) %>
      <% if (erro) { %><p class="error" role="alert"><%= erro %></p><% } %>
      <div class="dialog-actions"><a class="secondary" href="/servicos">Cancelar</a><button class="primary">Salvar</button></div>
    </form>
  </dialog>
<% } %>
</body></html>
